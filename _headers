# Cloudflare Pages Headers Configuration
# Optimized for Tantra Gyan Vedic Astrology PWA, High-Performance Caching & AI Crawlers

# 1. Global Security, Content & AI Discovery Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), accelerometer=(), camera=(), geolocation=(), microphone=()
  Link: </llms.txt>; rel="help"; type="text/plain", </llms-full.txt>; rel="alternate"; type="text/plain", </sitemap.xml>; rel="sitemap"; type="application/xml"

# 2. Service Worker (Never cache long term, allow root scope)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /
  Content-Type: application/javascript; charset=utf-8

# 3. PWA Web App Manifests
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

# 4. AI Ingestion Standard Endpoints (LLMs / GPTBot / ClaudeBot / Perplexity)
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

# 5. Search Engine Sitemaps & Robots
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# 6. Static Versioned Assets (CSS, JS, Fonts, Images) - 1 Year Cache
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
